# Sentinel AI Environment Configuration
# Copy this file to .env and configure as needed

# Application Settings
APP_NAME=Sentinel AI
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# Optional LLM Configuration (not required for basic functionality)
# LLM_PROVIDER=template
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=gpt-3.5-turbo

# Optional Threat Intelligence Configuration (not required for basic functionality)
# THREAT_INTEL_PROVIDER=mock
# THREAT_INTEL_API_KEY=your_api_key_here

# Data Configuration
DATA_DIR=data
MODEL_DIR=models
ARTIFACT_DIR=artifacts

# Model Configuration
RANDOM_SEED=42
MAX_FILE_SIZE_MB=100

# Security Settings
VALIDATE_UPLOADS=true
SANITIZE_OUTPUTS=true
LOG_SECURITY_EVENTS=true

# Demo Configuration
SYNTHETIC_DATA_ENABLED=true
MASK_IPS_IN_DEMO=true
